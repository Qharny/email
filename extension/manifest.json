{
  "manifest_version": 3,
  "name": "Email Sender",
  "short_name": "Email Sender",
  "version": "1.1.0",
  "description": "Send one email to many recipients from your Gmail accounts (or any SMTP account via the companion app).",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Email Sender",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["identity", "storage", "tabs"],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "https://www.googleapis.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ]
}
