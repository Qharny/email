{
    "manifest_version": 3,

    "name": "Email Sender",
    "version": "1.3.0",
    "description": "A minimal extension for sending one email to many people from your own Gmail, Outlook or SMTP accounts.",
    "author": "Qharny",
    "key": "",

    "icons": {
        "16": "assets/16x16.png",
        "32": "assets/32x32.png",
        "48": "assets/48x48.png",
        "128": "assets/128x128.png"
    },

    "action": {
        "default_title": "Email Sender",
        "default_popup": "src/popup/popup.html"
    },

    "permissions": ["identity", "storage", "tabs"],

    "host_permissions": [
        "https://gmail.googleapis.com/*",
        "https://www.googleapis.com/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
    ]
}
